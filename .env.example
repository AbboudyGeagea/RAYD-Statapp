
# ── HL7 / MLLP security (port 6661) ──────────────────────────────
# The MLLP listener has NO authentication: anyone who can reach port 6661 can
# inject HL7. Access is controlled by a source-IP whitelist applied to the
# DOCKER-USER iptables chain (published container ports bypass INPUT).
#
# HL7_ALLOWED_IPS: space- or comma-separated sender IPs/CIDRs. REQUIRED before
# running scripts/hl7_firewall.sh — the script refuses to run when empty rather
# than applying a deny-all that would take HL7 offline.
# Find the real senders:  docker compose logs rayd-app | grep -i mllp
#HL7_ALLOWED_IPS=10.20.30.40 10.20.30.41

# Optional defence in depth: bind the published port to one host interface.
# Leave unset (default 0.0.0.0) unless you know the correct NIC address.
# Do NOT set 127.0.0.1 — the PACS/HIS senders are remote and would be blocked.
#HL7_BIND_ADDR=0.0.0.0

# ── Web ports ────────────────────────────────────────────────────
# Port 80 is NOT published by docker-compose.yml. If something else already owns
# 80 on the host, a duplicate binding fails the entire `up`, not just nginx — so
# the HTTP->HTTPS redirect is given up rather than the whole stack.
# Override the HTTPS port here when 443 is taken as well.
#HTTPS_PORT=443

# ── Container name prefix ────────────────────────────────────────
# Lets a second checkout run on the same machine. Compose namespaces volumes and
# networks by project (the directory name) automatically, but container_name is
# global, so two clones would otherwise fight over "rayd_db".
# Leave unset for production — the default "rayd" keeps every existing command,
# including install.sh's `docker exec rayd_db ...`, working as before.
#RAYD_CONTAINER_PREFIX=raydtest

# ── Log directory ────────────────────────────────────────────────
# Host path bind-mounted to /opt/rayd/logs in the container. The default suits a
# Linux server. On Docker Desktop for Windows that path resolves inside the WSL
# VM, so logs are written somewhere real but hard to find — point it at the
# project instead when developing.
#RAYD_LOG_DIR=./logs

# ── ETL lookup source (NOT USED ON THE HL7 BRANCH) ───────────────
# Retained only so a merge from another branch does not silently drop it. ETL
# Phase 8 mined the PACS database for modalities and procedures; there is no PACS
# database here, and that master data arrives by MFN message or CSV import.
#RAYD_ETL_LOOKUP_FROM_PACS=false
